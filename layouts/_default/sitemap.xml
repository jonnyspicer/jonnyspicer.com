{{- /*
  Only indexable HTML pages: no taxonomy/term pages (categories, tags,
  series), no drafts, nothing noindexed (front matter or data/seo/noindex.yaml) or sitemap.disable, and nothing
  without an HTML output (e.g. the navbar JS).
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range where site.Pages "Kind" "in" (slice "home" "section" "page") }}
  {{- if and (.OutputFormats.Get "html") (not .Draft) (not (partial "seo/noindex.html" .)) (not .Sitemap.Disable) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- $lastmod := .Lastmod }}
    {{- if .IsHome }}{{ with first 1 (where site.RegularPages "Section" "blog") }}{{ $lastmod = (index . 0).Lastmod }}{{ end }}{{ end }}
    {{- if not $lastmod.IsZero }}
    <lastmod>{{ $lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
